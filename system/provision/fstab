# СНИМОК состояния конкретной сборки (PARTUUID e12ef54e), НЕ источник истины.
# deploy/local/deploy-local.sh и deploy/redeploy-plan.md этот файл не используют:
# рабочий fstab получается из fstab образа + правок deploy-local.sh (LABEL=malina,
# /var/lib/dhcp, /run/malina-ts-raw). PARTUUID здесь может не совпадать с образом.
proc            /proc           proc    defaults          0       0
PARTUUID=e12ef54e-01  /boot/firmware  vfat    ro,noatime                          0       2
PARTUUID=e12ef54e-02  /               ext4    ro,noatime,nodelalloc,commit=60     0       1
LABEL=malina  /malina  ext4  defaults,noatime  0  2
tmpfs   /tmp                    tmpfs   defaults,noatime,nosuid,nodev,mode=1777,size=64m   0 0
tmpfs   /var/log                tmpfs   defaults,noatime,nosuid,mode=0755,size=32m         0 0
tmpfs   /var/tmp                tmpfs   defaults,noatime,nosuid,nodev,mode=1777,size=32m   0 0
tmpfs   /var/spool              tmpfs   defaults,noatime,nosuid,nodev,mode=0755,size=32m   0 0
tmpfs   /var/lib/bluetooth      tmpfs   defaults,noatime,nosuid,nodev,mode=0755,size=16m   0 0
tmpfs   /var/lib/dhcp             tmpfs   defaults,noatime,nosuid,nodev,mode=0755,size=4m    0 0
tmpfs   /var/lib/systemd        tmpfs   defaults,noatime,nosuid,nodev,mode=0755,size=32m   0 0
