[Unit]
Description=DHCPv4 client for eth0 (malina)
Wants=network.target
Before=network.target

[Service]
Type=simple
ExecStart=/sbin/dhclient -4 -d -pf /run/malina-net/dhclient.eth0.pid -lf /var/lib/dhcp/dhclient.eth0.leases eth0
ExecStop=/sbin/dhclient -4 -pf /run/malina-net/dhclient.eth0.pid -lf /var/lib/dhcp/dhclient.eth0.leases -r eth0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
