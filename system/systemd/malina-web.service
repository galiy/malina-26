[Unit]
Description=Malina web UI (admin)
Wants=network.target
After=network.target dhclient-eth0.service

[Service]
Type=simple
ExecStart=/malina/usr/local/bin/malina-web -listen :80 -user malina -assets /malina/usr/local/share/malina/web
Restart=always
RestartSec=3
# Web-админка работает от root и выполняет системные операции (chpasswd, mount
# в malina-rw, sysctl), поэтому набор привилегий НЕ ограничивается:
# CapabilityBoundingSet ломает pam_chauthtok при смене пароля.

[Install]
WantedBy=multi-user.target
