# Низкая задержка USB-RS232/USB-serial для побайтового эхо-протокола МАП.
#
# FTDI-чипы (и клоны) по умолчанию копят принятые байты до 16 мс (latency_timer),
# из-за чего эхо каждого байта приходит с задержкой и МАП отдаёт ErrRS_eco
# («код 2»). Ставим 1 мс там, где параметр поддерживается (FTDI/vendor-драйверы
# с атрибутом latency_timer). Для драйверов без такого атрибута (PL2303, CP210x,
# CH341) правило просто не срабатывает — на них параметра нет.
#
# Аналог настройки Windows «Время ожидания (мсек): 1» в свойствах COM-порта.

ACTION=="add", SUBSYSTEM=="usb-serial", DRIVER=="ftdi_sio", ATTR{latency_timer}="1"
ACTION=="add", SUBSYSTEM=="usb-serial", ATTR{latency_timer}=="*", ATTR{latency_timer}="1"
