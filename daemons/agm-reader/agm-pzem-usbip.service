[Unit]
Description=AGM PZEM-017 usbip exporter
After=local-fs.target rsyslog.service usbipd.service
Wants=usbipd.service rsyslog.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/malina/usr/local/sbin/agm-pzem-usbip
RuntimeDirectory=agm-pzem-usbip
RuntimeDirectoryMode=0755
# bind/unbind требует root; сервис работает от root.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
